  m_Script: {fileID: 11500000, guid: 4b26a3e4f68d1bf41835aa62dc199403, type: 3}
  m_Name: GuardianSpirit
  m_EditorClassIdentifier: Bastion.Runtime::Bastion.Dialogue.DialogueData
  SpeakerName: "\uC131\uCC44\uC758 \uC218\uD638\uB839"
  Lines:
  - "\uAE30\uC0AC\uC5EC, \uB4DC\uB514\uC5B4 \uC654\uAD6C\uB098. \uC774 \uC131\uCC44\uB294 \uC218\uD638\uC790\uAC00 \uD0C0\uB77D\uD55C \uB4A4\uB85C \uC800\uC8FC\uC5D0 \uC7A0\uACA8 \uC788\uB2E4."
  - "\uBC14\uB2E5\uC758 \uBD84\uCD9C\uAD6C\uB294 \uC7A0\uC2DC \uB2EC\uC544\uC624\uB978 \uB4A4 \uBD88\uAE30\uB465\uC744 \uBFDC\uB294\uB2E4. \uBD88\uD2F0\uAC00 \uBCF4\uC774\uBA74 \uBB3C\uB7EC\uC11C\uAC70\uB098 X\uB85C \uAD74\uB7EC \uC9C0\uB098\uAC00\uB77C."
  - "\uCD1B\uB300\uC5D0 \uBD88\uC744 \uBC1D\uD788\uBA74 \uADF8\uACF3\uC5D0\uC11C \uB2E4\uC2DC \uC77C\uC5B4\uC124 \uC218 \uC788\uB2E4. \uBD89\uC740 \uBB3C\uC57D\uC740 \uC0C1\uCC98\uB97C \uC544\uBB3C\uAC8C \uD558\uC9C0."
  - "\uAC00\uC7A5 \uAE4A\uC740 \uACF3\uC5D0 \uD0C0\uB77D\uD55C \uC218\uD638\uC790\uAC00 \uC788\uB2E4. \uADF8\uC758 \uB0AB\uC774 \uBE5B\uC744 \uBAA8\uC744 \uB54C\uB97C \uB193\uCE58\uC9C0 \uB9C8\uB77C."
